# =============================================================================
# Vietlook Travel — .gitignore dùng chung cho cả repo (fe/ + be/)
# Quy tắc riêng từng phần nằm ở fe/.gitignore và be/.gitignore
# =============================================================================

# ----- Dependencies -----
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.npm/

# ----- Biến môi trường (KHÔNG BAO GIỜ commit key thật) -----
.env
.env.*
!.env.example
!.env.*.example

# ----- Bí mật / chứng chỉ -----
*.pem
*.key
*.crt
*.p12
*.pfx
secrets/
credentials*.json
service-account*.json

# ----- Logs -----
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ----- Test / coverage -----
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/

# ----- Build output -----
dist/
build/
out/
.cache/
.turbo/
*.tsbuildinfo

# ----- Hệ điều hành -----
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ----- Editor / IDE -----
.idea/
*.swp
*.swo
*~
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
*.sublime-project
*.sublime-workspace

# ----- File tạm -----
tmp/
temp/
*.tmp
*.bak
~$*

# ----- Tài liệu nội bộ: chỉ đưa vào repo hướng dẫn deploy + file đối chiếu URL web cũ (.csv) -----
# (file docs/ đã theo dõi từ trước vẫn giữ nguyên)
docs/*
!docs/DEPLOY.md
!docs/*.csv
