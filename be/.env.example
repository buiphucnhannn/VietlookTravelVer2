# =============================================================================
# be/ — biến môi trường mẫu. Sao chép thành .env rồi điền giá trị:
#   cp .env.example .env
# KHÔNG commit file .env (đã có trong .gitignore). Production: đặt biến trên server / PM2.
# =============================================================================

# ===== Server =====
NODE_ENV=development
PORT=4000
# debug | info (mặc định) | warn | error | silent
LOG_LEVEL=info
# Tên miền được gọi thẳng API (cách nhau dấu phẩy). Website gọi qua chính tên miền của nó
# (Next.js rewrite /api/v1 → backend) thì KHÔNG cần khai ở đây.
CORS_ORIGINS=http://localhost:3000
# Số proxy tin cậy phía trước (quan trọng cho rate limit theo IP):
#   local qua Next.js rewrite: 1  ·  VPS sau Nginx: 1  ·  Vercel → Nginx → API: 2
TRUST_PROXY=1
# "Khóa cửa sau": mã bí mật CHUNG với frontend (đặt CÙNG giá trị ở Vercel, biến PROXY_SECRET).
# Có giá trị → chỉ nhận request đi qua website (header X-Proxy-Secret). Trống → tắt (máy dev).
PROXY_SECRET=

# ===== MongoDB =====
# Atlas → Database → Connect → Drivers → copy chuỗi kết nối (thay <db_password>)
# Hoặc MongoDB trên VPS: mongodb://<user>:<password>@127.0.0.1:27017/?authSource=admin
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<app>
MONGODB_DB_NAME=vietlook

# ===== Cloudinary =====
# Cloudinary Console → Settings → API Keys
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Thư mục gốc chứa ảnh của website trên Cloudinary (chỉ được xoá ảnh trong thư mục này)
CLOUDINARY_FOLDER=vietlook

# ===== Đăng nhập quản trị (JWT trong cookie HttpOnly) =====
# Tạo secret ngẫu nhiên: npm run secret   (>= 32 ký tự, 2 secret phải KHÁC nhau)
# Bỏ trống khi dev → tự sinh mỗi lần chạy (khởi động lại phải đăng nhập lại). Production: BẮT BUỘC.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Thời hạn token: s | m | h | d
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# Số thiết bị đăng nhập cùng lúc tối đa / tài khoản
MAX_SESSIONS=5
# Cookie chỉ gửi qua HTTPS — mặc định bật ở production
# COOKIE_SECURE=true

# Khoá tài khoản tạm thời khi nhập sai mật khẩu nhiều lần
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Giới hạn chung mỗi IP: số request / cửa sổ thời gian (ms)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=3000

# ===== Captcha cho form công khai (Cloudflare Turnstile — miễn phí) =====
# Cloudflare Dashboard → Turnstile → Add site → copy Secret Key (Site Key đặt ở frontend)
# Trống → bỏ qua kiểm tra captcha, form vẫn gửi được (server cảnh báo khi chạy production).
# Có giá trị → frontend PHẢI có Site Key tương ứng, nếu không mọi form công khai bị từ chối.
TURNSTILE_SECRET_KEY=

# ===== Mã hoá dữ liệu nhạy cảm trong DB (key 9Pay…) =====
# Tạo: npm run secret. Production: BẮT BUỘC (>= 32 ký tự). Đổi khoá → phải nhập lại key 9Pay trong CMS.
DATA_ENCRYPTION_KEY=

# ===== Email thông báo (Resend — https://resend.com) =====
# Trống RESEND_API_KEY → không gửi email, mọi đơn / yêu cầu VẪN lưu trong CMS (đánh dấu "chưa gửi email").
# Người nhận cài trong CMS (Cài đặt → Email nhận thông báo).
# Đơn mới: email cho công ty (người nhận trong CMS) + email xác nhận cho khách (nếu bật trong CMS).
# Đơn gửi email lỗi → CMS đánh dấu, nhân viên bấm "Gửi lại email".
RESEND_API_KEY=
# Người gửi. onboarding@resend.dev chỉ gửi được tới email chủ tài khoản Resend (email xác nhận cho KHÁCH sẽ lỗi)
# → production phải xác minh tên miền trên Resend rồi đổi, vd: Vietlook Travel <booking@vietlooktravel.com>
MAIL_FROM=Vietlook Travel <onboarding@resend.dev>
# Email nhận thông báo dự phòng — dùng khi CMS chưa cài người nhận nào
NOTIFY_EMAIL=infovietlooktravel@gmail.com
# CHỈ cho máy dev / bản thử nghiệm: có giá trị → MỌI email (cho công ty lẫn cho khách) chỉ gửi tới
# địa chỉ này; người nhận thật hiện ở tiêu đề "[DEV → khach@…]" và dải vàng đầu email.
# Production: ĐỂ TRỐNG (nếu không khách và nhân viên sẽ không nhận được email).
MAIL_REDIRECT_TO=
# Địa chỉ website (link trong email, nút "Mở trong CMS"), không có dấu / cuối
PUBLIC_SITE_URL=https://vietlooktravel.vercel.app

# ===== Tài khoản admin đầu tiên =====
# Server tạo tài khoản này khi khởi động NẾU CHƯA CÓ. Sau đó mật khẩu / tên đổi ngay trong trang quản trị
# (mục Đổi mật khẩu) — các dòng dưới không ghi đè tài khoản đã tồn tại.
# Quên mật khẩu: sửa ADMIN_PASSWORD ở đây rồi chạy  npm run admin:reset
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_NAME=Quản trị viên

# ===== Đăng nhập nhanh (CHỈ cho bản demo) =====
# true → trang /login có nút "Đăng nhập nhanh": BẤT KỲ AI mở trang cũng vào thẳng tài khoản ADMIN_USERNAME
# (quyền admin, không cần mật khẩu). Mặc định false. Server ghi cảnh báo mỗi lần khởi động khi đang bật.
# ⚠ Bàn giao / chạy thật trên tên miền chính: BẮT BUỘC false.
DEMO_LOGIN=false
