# Copy thành .env.local (máy dev) — trên Vercel đặt ở Settings → Environment Variables

# Backend (thư mục be/). Máy dev bỏ trống = http://localhost:4000. Production: BẮT BUỘC.
BACKEND_URL=

# Mã bí mật chung với backend (CÙNG giá trị PROXY_SECRET trong be/.env). Máy dev có thể bỏ trống.
PROXY_SECRET=

# Tên miền CHÍNH của website (canonical, hreflang, og:url, sitemap, robots, JSON-LD).
# Production nên đặt rõ, VD https://vietlooktravel.vercel.app (đổi sang tên miền riêng khi có) rồi Redeploy.
# Bỏ trống = https://vietlooktravel.vercel.app (không bao giờ dùng link preview / tên mặc định của dự án Vercel).
NEXT_PUBLIC_SITE_URL=

# Cho Google lập chỉ mục (robots.txt + thẻ noindex). Bỏ trống = TỰ ĐỘNG theo NEXT_PUBLIC_SITE_URL:
# tên miền thật (VD https://vietlooktravel.com) → cho index; *.vercel.app / localhost / preview / staging
# / bản Vercel Preview → chặn (robots.txt "Disallow: /", mọi trang noindex). Thường KHÔNG cần đặt.
# Chỉ đặt khi cần ép: true = luôn cho index, false = luôn chặn (VD tên miền thật nhưng chưa muốn lên Google).
NEXT_PUBLIC_ALLOW_INDEXING=

# Cloudflare Turnstile — Site key (captcha form). Bỏ trống = không hiện captcha (Secret key đặt ở be/.env).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudinary (thông tin công khai — tên cloud chứa ảnh). Mặc định đã đúng tài khoản của dự án.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dzpmroj28
NEXT_PUBLIC_CLOUDINARY_FOLDER=vietlook
