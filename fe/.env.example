# Copy thành .env.local (máy dev) — trên Vercel đặt ở Settings → Environment Variables

# Backend (thư mục be/). Máy dev bỏ trống = http://localhost:4000. Production: BẮT BUỘC.
BACKEND_URL=

# Mã bí mật chung với backend (CÙNG giá trị PROXY_SECRET trong be/.env). Máy dev có thể bỏ trống.
PROXY_SECRET=

# Tên miền website (canonical, hreflang, sitemap). Bỏ trống = tự nhận trên Vercel.
NEXT_PUBLIC_SITE_URL=

# Cloudflare Turnstile — Site key (captcha form). Bỏ trống = không hiện captcha (Secret key đặt ở be/.env).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cloudinary (thông tin công khai — tên cloud chứa ảnh). Mặc định đã đúng tài khoản của dự án.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=dzpmroj28
NEXT_PUBLIC_CLOUDINARY_FOLDER=vietlook
